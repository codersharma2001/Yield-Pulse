# API Configuration
# Leave empty to use Next.js API routes (recommended for Vercel deployment)
# Only set this if you want to use an external API server
NEXT_PUBLIC_API_BASE_URL=

# Tenderly Configuration (for transaction simulation)
# Get your API key from https://dashboard.tenderly.co/
NEXT_PUBLIC_TENDERLY_API_KEY=your_tenderly_api_key_here
NEXT_PUBLIC_TENDERLY_PROJECT=your_project_name
NEXT_PUBLIC_TENDERLY_ACCOUNT=your_account_name

# WalletConnect Project ID (for Web3 wallet connections)
# Get your project ID from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Optional: RPC URLs (Vercel deployment will use public RPCs if not set)
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_POLYGON_RPC_URL=
NEXT_PUBLIC_ARBITRUM_RPC_URL=
NEXT_PUBLIC_BSC_RPC_URL=
