{
  "name": "@yield-dashboard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap",
    "start": "node ./dist/index.mjs",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "format": "prettier --check .",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "fastify": "4.25.1",
    "fastify-plugin": "4.5.0",
    "ioredis": "5.3.2",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/node": "20.11.19",
    "@typescript-eslint/eslint-plugin": "6.20.0",
    "@typescript-eslint/parser": "6.20.0",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.1.1",
    "rimraf": "5.0.5",
    "tsup": "7.2.0",
    "tsx": "4.7.0",
    "typescript": "5.3.3",
    "vitest": "1.2.2"
  }
}
